# Copy this file to .env and fill in both values.

# OpenRouter API key — https://openrouter.ai/keys
# The key is account-wide; it is not tied to any particular model.
OPENROUTER_API_KEY=

# Supabase Postgres connection string, using the read-only role created by
# migrations/002_readonly_role.sql — NOT the postgres superuser.
#
# Use the Transaction Pooler (port 6543) connection string from
# Supabase → Project Settings → Database → Connection string, then swap in
# the sql_assistant_ro user and its password. The pooler matters: Streamlit
# reruns on every interaction and the direct connection limit is small.
#
# Format:
#   postgresql+psycopg2://sql_assistant_ro:PASSWORD@HOST:6543/postgres?sslmode=require
DATABASE_URL=
