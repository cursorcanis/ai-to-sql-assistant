# Copy this file to .env and fill in the values. .env is git-ignored.

# --- OpenRouter -------------------------------------------------------------
# https://openrouter.ai/keys — the key is account-wide, not per-model.
OPENROUTER_API_KEY=

# --- Database (what the app uses) -------------------------------------------
# The read-only role created by migrations/002, via Supabase's TRANSACTION
# pooler on port 6543.
#
# Two things catch people out here:
#   1. Through the pooler the username needs the project ref appended,
#      e.g. sql_assistant_ro.abcdefghijklmnop — not plain sql_assistant_ro.
#   2. The direct host (db.<ref>.supabase.co) is IPv6-only and will not
#      resolve on most networks. Use the pooler host from Supabase's
#      "Connect" dialog.
#
# Keep the password alphanumeric: characters like # and @ break URL parsing.
DATABASE_URL=postgresql+psycopg2://sql_assistant_ro.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# --- Migration-only settings ------------------------------------------------
# Superuser connection, used ONLY by scripts/run_migrations.py. The app never
# reads this. Safe to delete once the migrations have run. Uses the SESSION
# pooler (port 5432) because migrations run DDL.
SUPABASE_ADMIN_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Password assigned to the read-only role by migrations/002. Substituted into
# the SQL at run time so it never appears in a committed file. Must match the
# password in DATABASE_URL above.
SQL_ASSISTANT_RO_PASSWORD=
